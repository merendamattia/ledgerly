{
  "name": "ledgerly-backend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/api/app.ts",
    "./auth": "./src/core/auth.ts"
  },
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "test": "bun test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "bun prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "prices:backfill": "bun scripts/backfill-prices.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-auth": "^1.6.18",
    "croner": "^10.0.1",
    "date-fns": "^4.4.0",
    "hono": "^4.12.25",
    "ioredis": "^5.11.1",
    "yahoo-finance2": "^3.15.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "typescript": "^6.0.3"
  }
}
