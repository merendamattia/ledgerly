// Ledgerly — data schema (the backend is the sole owner of the database).
// Auth models (User/Session/Account/Verification) are managed by Better Auth.
// The financial account is named `CashAccount` to avoid clashing with Better Auth's Account.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Auth (Better Auth, Prisma adapter)
// ----------------------------------------------------------------------------
model User {
  id                     String                  @id
  name                   String
  email                  String                  @unique
  emailVerified          Boolean                 @default(false)
  image                  String?
  role                   String                  @default("user")
  banned                 Boolean                 @default(false)
  banReason              String?
  banExpires             DateTime?
  mustChangePassword     Boolean                 @default(false)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  sessions               Session[]
  accounts               Account[]
  settings               Settings[]
  cashAccounts           CashAccount[]
  debts                  Debt[]
  tickers                Ticker[]
  holdings               Holding[]
  investmentTransactions InvestmentTransaction[]
  categories             Category[]
  transactions           Transaction[]
  recurringExpenses      RecurringExpense[]
  netWorthSnapshots      NetWorthSnapshot[]
  rebalanceGroups        RebalanceGroup[]
  pillars                Pillar[]
  personalApiToken       PersonalApiToken?

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ----------------------------------------------------------------------------
// Domain: net worth, investments, expenses
// ----------------------------------------------------------------------------
enum TickerType {
  EQUITY
  ETF
  CRYPTO
  BOND
  COMMODITY
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum TxDirection {
  INCOME
  EXPENSE
}

enum InvestmentSide {
  BUY
  SELL
}

enum CronStatus {
  RUNNING
  SUCCESS
  FAILED
}

/// What a cash account represents in the net-worth breakdown. LIQUIDITY is the
/// classic cash/bank balance; CREDIT is money owed to you (receivables); OTHER_ASSET
/// is any other manually-tracked asset. All three are snapshot-managed identically.
enum CashCategory {
  LIQUIDITY
  CREDIT
  OTHER_ASSET
}

enum CronTrigger {
  CRON
  MANUAL
}

/// The cadence unit of a recurring expense (paired with an integer count, e.g.
/// 30 + DAY = "every 30 days", 2 + WEEK, 1 + MONTH).
enum RecurInterval {
  DAY
  WEEK
  MONTH
}

/// How a recurring expense stops generating movements.
enum RecurEndMode {
  NEVER
  AFTER_OCCURRENCES
  ON_DATE
}

/// User-owned settings. A row is provisioned for every authenticated user.
model Settings {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  baseCurrency String   @default("EUR")
  lastSeenReleaseVersion String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// One active, user-owned token for narrow external integrations.
model PersonalApiToken {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  prefix    String
  suffix    String
  createdAt DateTime @default(now())

  @@map("personal_api_token")
}

/// Liquid account (bank, cash, ...).
model CashAccount {
  id                     String                  @id @default(cuid())
  userId                 String
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                   String
  type                   String                  @default("BANK")
  category               CashCategory            @default(LIQUIDITY)
  currency               String                  @default("EUR")
  balance                Decimal                 @default(0) @db.Decimal(20, 2)
  note                   String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  holdings               Holding[]
  snapshots              CashSnapshot[]
  investmentTransactions InvestmentTransaction[]
  pillarMembers          PillarMember[]

  @@map("cash_account")
}

/// Dated balance snapshot for a cash account. The latest snapshot (<= today) is
/// the source of truth for an account's current balance.
model CashSnapshot {
  id            String      @id @default(cuid())
  cashAccountId String
  cashAccount   CashAccount @relation(fields: [cashAccountId], references: [id], onDelete: Cascade)
  date          DateTime    @db.Date
  balance       Decimal     @db.Decimal(20, 2)
  note          String?
  createdAt     DateTime    @default(now())

  @@unique([cashAccountId, date])
  @@index([cashAccountId])
  @@map("cash_snapshot")
}

/// A liability (loan, mortgage, credit card balance, ...). Subtracted from net worth.
model Debt {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  type      String         @default("LOAN")
  currency  String         @default("EUR")
  amount    Decimal        @db.Decimal(20, 2)
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  snapshots DebtSnapshot[]

  @@map("debt")
}

/// Dated balance snapshot for a debt. The latest snapshot (<= today) is the
/// source of truth for a debt's current amount.
model DebtSnapshot {
  id        String   @id @default(cuid())
  debtId    String
  debt      Debt     @relation(fields: [debtId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  amount    Decimal  @db.Decimal(20, 2)
  note      String?
  createdAt DateTime @default(now())

  @@unique([debtId, date])
  @@index([debtId])
  @@map("debt_snapshot")
}

/// User-owned financial instrument metadata. Provider-backed price history is
/// shared by provider and symbol; manual prices and user-specific anchors stay
/// in the ticker-local PriceHistory table below.
model Ticker {
  id                     String                  @id @default(cuid())
  userId                 String
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol                 String
  isin                   String?
  name                   String
  description            String?
  type                   TickerType
  currency               String                  @default("USD")
  provider               String
  createdAt              DateTime                @default(now())
  prices                 PriceHistory[]
  holdings               Holding[]
  investmentTransactions InvestmentTransaction[]
  rebalanceMembers       RebalanceMember[]
  pillarMembers          PillarMember[]

  @@unique([userId, symbol])
  @@map("ticker")
}

/// User-owned prices and provider-specific overrides (manual assets and
/// purchase anchors). Provider-backed bars live in ProviderPriceHistory.
model PriceHistory {
  id       String   @id @default(cuid())
  tickerId String
  ticker   Ticker   @relation(fields: [tickerId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  close    Decimal  @db.Decimal(20, 8)

  @@unique([tickerId, date])
  @@index([tickerId])
  @@map("price_history")
}

/// Shared daily closing prices for provider-backed symbols. This table has no
/// user relation so one provider fetch can serve every user's matching ticker.
model ProviderPriceHistory {
  id       String   @id @default(cuid())
  provider String
  symbol   String
  date     DateTime @db.Date
  close    Decimal  @db.Decimal(20, 8)

  @@unique([provider, symbol, date])
  @@index([provider, symbol])
  @@map("provider_price_history")
}

/// An investment position.
model Holding {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickerId      String
  ticker        Ticker       @relation(fields: [tickerId], references: [id], onDelete: Restrict)
  cashAccountId String?
  cashAccount   CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  quantity      Decimal      @db.Decimal(28, 10)
  avgCost       Decimal      @db.Decimal(20, 8)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([tickerId])
  @@map("holding")
}

/// A buy/sell movement on a tracked asset. The Holding (quantity + avgCost) is
/// derived from the full set of these transactions per ticker.
model InvestmentTransaction {
  id            String         @id @default(cuid())
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tickerId      String
  ticker        Ticker         @relation(fields: [tickerId], references: [id], onDelete: Restrict)
  cashAccountId String?
  cashAccount   CashAccount?   @relation(fields: [cashAccountId], references: [id], onDelete: SetNull)
  date          DateTime       @db.Date
  side          InvestmentSide
  quantity      Decimal        @db.Decimal(28, 10)
  price         Decimal        @db.Decimal(20, 8)
  fee           Decimal        @default(0) @db.Decimal(20, 2)
  note          String?
  createdAt     DateTime       @default(now())

  @@index([tickerId])
  @@index([cashAccountId])
  @@index([date])
  @@map("investment_transaction")
}

/// Historical FX rates (daily closes).
model FxRate {
  id    String   @id @default(cuid())
  base  String
  quote String
  date  DateTime @db.Date
  rate  Decimal  @db.Decimal(20, 8)

  @@unique([base, quote, date])
  @@index([base, quote])
  @@map("fx_rate")
}

/// User-managed expense/income categories.
model Category {
  id                String             @id @default(cuid())
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  kind              CategoryKind
  emoji             String?
  createdAt         DateTime           @default(now())
  transactions      Transaction[]
  recurringExpenses RecurringExpense[]

  @@unique([userId, kind, name])
  @@map("category")
}

/// An expense/income movement (in base currency).
model Transaction {
  id                 String            @id @default(cuid())
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  date               DateTime          @db.Date
  amount             Decimal           @db.Decimal(20, 2)
  direction          TxDirection
  note               String?
  recurringExpenseId String?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  createdAt          DateTime          @default(now())

  @@index([date])
  @@index([categoryId])
  @@index([recurringExpenseId])
  @@map("transaction")
}

/// A user-defined movement (income or expense) that repeats on a fixed cadence.
/// The nightly `recurring-expenses` cron books a Transaction for every due
/// occurrence and advances `nextRunDate`, stopping at the chosen end condition.
model RecurringExpense {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  amount           Decimal       @db.Decimal(20, 2)
  direction        TxDirection
  note             String?
  intervalUnit     RecurInterval
  intervalCount    Int
  startDate        DateTime      @db.Date
  nextRunDate      DateTime      @db.Date
  endMode          RecurEndMode  @default(NEVER)
  maxOccurrences   Int?
  endDate          DateTime?     @db.Date
  occurrencesCount Int           @default(0)
  enabled          Boolean       @default(true)
  createdAt        DateTime      @default(now())
  transactions     Transaction[]

  @@index([nextRunDate])
  @@map("recurring_expense")
}

/// Daily net worth snapshot.
model NetWorthSnapshot {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  totalValue Decimal  @db.Decimal(20, 2)
  breakdown  Json
  createdAt  DateTime @default(now())

  @@unique([userId, date])
  @@map("net_worth_snapshot")
}

/// A rebalance row: one or more tickers treated as a single asset with a target
/// allocation. A buy/sell action triggers when |current% − target%| ≥ thresholdPct.
model RebalanceGroup {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  targetPct    Decimal           @db.Decimal(5, 2)
  thresholdPct Decimal           @default(5) @db.Decimal(5, 2)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  members      RebalanceMember[]

  @@map("rebalance_group")
}

/// Membership of a ticker in a rebalance group (a ticker belongs to at most one).
model RebalanceMember {
  id       String         @id @default(cuid())
  groupId  String
  group    RebalanceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tickerId String
  ticker   Ticker         @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  @@unique([tickerId])
  @@unique([groupId, tickerId])
  @@index([groupId])
  @@map("rebalance_member")
}

/// One of the four investment pillars: a named macro-bucket of cash accounts
/// and/or tracked assets. `position` is the pillar number (1–4).
model Pillar {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  position  Int
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  members   PillarMember[]

  @@unique([userId, position])
  @@map("pillar")
}

/// A pillar member: exactly one of cashAccountId / tickerId is set.
model PillarMember {
  id            String       @id @default(cuid())
  pillarId      String
  pillar        Pillar       @relation(fields: [pillarId], references: [id], onDelete: Cascade)
  cashAccountId String?
  cashAccount   CashAccount? @relation(fields: [cashAccountId], references: [id], onDelete: Cascade)
  tickerId      String?
  ticker        Ticker?      @relation(fields: [tickerId], references: [id], onDelete: Cascade)

  @@unique([pillarId, cashAccountId])
  @@unique([pillarId, tickerId])
  @@index([pillarId])
  @@map("pillar_member")
}

/// A cron job definition.
model CronJob {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  schedule    String?
  enabled     Boolean   @default(true)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())
  runs        CronRun[]

  @@map("cron_job")
}

/// Execution log for a cron job.
model CronRun {
  id             String      @id @default(cuid())
  jobId          String
  job            CronJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  startedAt      DateTime    @default(now())
  finishedAt     DateTime?
  status         CronStatus  @default(RUNNING)
  itemsProcessed Int         @default(0)
  attempts       Int         @default(1)
  error          String?
  log            String?
  triggeredBy    CronTrigger @default(CRON)

  @@index([jobId])
  @@index([startedAt])
  @@map("cron_run")
}
