# ============================================================================
# Ledgerly — environment variables
# The BACKEND (src/backend) uses all of these. The FRONTEND (src/frontend) uses
# only the variables marked [frontend].
# ============================================================================

# --- App / Auth (Better Auth) -----------------------------------------------
BETTER_AUTH_SECRET=        # Better Auth secret (generate random, >= 32 chars)
BETTER_AUTH_URL=           # public backend URL (e.g. https://api.ledgerly.yourdomain)
ADMIN_EMAIL=               # initial administrator account
ADMIN_PASSWORD=            # initial administrator password

# --- Cron -------------------------------------------------------------------
CRON_SECRET=               # secret header for the scheduled task (Coolify)

# --- Postgres (Coolify resource) --------------------------------------------
# From the Coolify PostgreSQL resource copy: user, password, db, INTERNAL host, port 5432
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- Redis (Coolify resource) -----------------------------------------------
# From the Coolify Redis resource copy: password and INTERNAL host
REDIS_URL=redis://default:PASSWORD@HOST:6379

# --- Apple Wallet worker ----------------------------------------------------
APP_ENV=development
OPENAI_API_KEY=          # worker only; used opaquely for OpenAI requests
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
APPLE_PAY_WORKER_CONCURRENCY=1

# --- Web Push (optional; generate once with `bunx web-push generate-vapid-keys`) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Server -----------------------------------------------------------------
PORT=3001                  # Hono backend port
FRONTEND_URL=              # frontend URL, used for CORS (e.g. https://ledgerly.yourdomain)

# --- Frontend ---------------------------------------------------------------
# [frontend] public backend URL used by the Next.js client
NEXT_PUBLIC_API_URL=http://localhost:3001
# [frontend] iCloud Shortcut shown in Advanced settings (baked at image build)
NEXT_PUBLIC_APPLE_PAY_SHORTCUT_URL=https://www.icloud.com/shortcuts/482dbff891ee48098294df6ac773702f
# [frontend] backend URL for server-side calls (internal network in prod)
BACKEND_INTERNAL_URL=http://localhost:3001
