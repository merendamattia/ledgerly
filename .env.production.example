# Production env for Coolify (docker-compose.prod.yml). Fill these in the Coolify
# project env. Postgres and Redis are managed Coolify resources — copy their
# internal credentials into DATABASE_URL / REDIS_URL.

# --- Managed resources (from Coolify) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ledgerly
REDIS_URL=redis://HOST:6379

# --- Apple Wallet worker ---
APP_ENV=production
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
APPLE_PAY_WORKER_CONCURRENCY=1

# --- Web Push (optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Auth ---
BETTER_AUTH_SECRET=change-me-min-16-chars
BETTER_AUTH_URL=https://api.ledgerly.yourdomain      # public backend URL
ADMIN_EMAIL=admin@yourdomain
ADMIN_PASSWORD=change-me-min-8-chars

# --- Cron (HTTP manual trigger; nightly job runs in-process) ---
CRON_SECRET=change-me-min-8-chars

# --- URLs ---
FRONTEND_URL=https://ledgerly.yourdomain             # public frontend URL (CORS)
NEXT_PUBLIC_API_URL=https://api.ledgerly.yourdomain  # baked into client bundle at build
NEXT_PUBLIC_APPLE_PAY_SHORTCUT_URL=https://www.icloud.com/shortcuts/482dbff891ee48098294df6ac773702f  # baked into client bundle at build

# --- Optional ---
# CRON_ENABLED=true
# CRON_SCHEDULE=0 2 * * *
# CRON_TIMEZONE=Europe/Rome
